{
  "name": "actionmcp",
  "version": "0.3.0",
  "description": "WebMCP tools from your Server Actions. Opt-in, typed, safe by default.",
  "license": "MIT",
  "author": "Valentin Galfre",
  "homepage": "https://github.com/galfrevn/actionmcp#readme",
  "bugs": "https://github.com/galfrevn/actionmcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galfrevn/actionmcp.git",
    "directory": "packages/actionmcp"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "nextjs",
    "server-actions",
    "server-functions",
    "ai-agents",
    "standard-schema"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "actionmcp": "dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-json-schema-generator": "^2.10.0"
  },
  "peerDependenciesMeta": {
    "ts-json-schema-generator": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@w3c/webmcp-polyfill": "^0.2.0",
    "oxc-parser": "^0.160.0",
    "tinyglobby": "^0.2.17",
    "webmcp-types": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/coverage-v8": "^5.0.0",
    "arktype": "^2.2.10",
    "jsdom": "^27.0.0",
    "next": "16.4.6",
    "next-safe-action": "^8.7.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "^1.3.3",
    "ts-json-schema-generator": "~2.10.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "valibot": "^1.5.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.7"
  }
}
