{
  "name": "actionmcp-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build --filter=actionmcp",
    "build:fixtures": "turbo run build --filter='./fixtures/*'",
    "build:examples": "turbo run build --filter='./examples/*'",
    "test": "turbo run test --filter=actionmcp",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:e2e": "playwright test --project=polyfill",
    "test:e2e:native": "playwright test --project=native",
    "test:package": "vitest run --config tests/package/vitest.config.ts",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "bench": "pnpm --filter actionmcp-bench start",
    "bench:smoke": "pnpm --filter actionmcp-bench smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "oxfmt": "0.80.0",
    "oxlint": "^1.95.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "webmcp-types": "^0.2.0"
  }
}
